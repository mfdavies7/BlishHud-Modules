<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>bytex.bh.TyriaSearch</AssemblyName>
    <RootNamespace>Bytex.TyriaSearch</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <BlishHUDModuleFileName>bytex.bh.TyriaSearch</BlishHUDModuleFileName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Blish HUD supplies these at runtime, so keep them out of the .bhm -->
    <PackageReference Include="BlishHUD" Version="1.3.0" ExcludeAssets="runtime;analyzers" />
    <!-- For the manifest's version (SemVer.Version), which Blish HUD also supplies -->
    <PackageReference Include="SemanticVersioning" Version="1.2.2" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- Code shared by every module in this repo -->
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
