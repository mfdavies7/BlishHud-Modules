<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>WaypointPaste</AssemblyName>
    <RootNamespace>WaypointPaste</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Blish HUD supplies these at runtime, so keep them out of the .bhm -->
    <PackageReference Include="BlishHUD" Version="1.3.0" ExcludeAssets="runtime;analyzers" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.ComponentModel.Composition" />
    <!-- Mouse.GetPosition returns System.Drawing.Point -->
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Code shared by every module in this repo -->
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
