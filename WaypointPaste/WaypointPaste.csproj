<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>bytex.waypointpaste</AssemblyName>
    <RootNamespace>Bytex.WaypointPaste</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- The .bhm is named bytex.waypointpaste_<version>, the version read from manifest.json -->
    <ModuleVersion>$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\manifest.json')), '"version"\s*:\s*"([^"]+)"').Groups[1].Value)</ModuleVersion>
    <BlishHUDModuleFileName>bytex.waypointpaste_$(ModuleVersion)</BlishHUDModuleFileName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Blish HUD supplies these at runtime, so keep them out of the .bhm -->
    <PackageReference Include="BlishHUD" Version="1.3.0" ExcludeAssets="runtime;analyzers" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.ComponentModel.Composition" />
    <!-- Mouse.GetPosition returns System.Drawing.Point -->
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- Code shared by every module in this repo -->
    <Compile Include="..\Shared\*.cs" Link="Shared\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
